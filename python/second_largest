def partition(a,l,h):
    pivot = a[l]
    start = l
    end = h
    while (start<end):
        while a[start] <= pivot:
            start += 1
        while a[end] > pivot:
            end -= 1
        if (start < end):
            a[start], a[end] = a[end], a[start]
    a[end], a[l] = a[l], a[end]
    return end;

def qS(a, l, h):
    if (l<h):
        p = partition(a,l,h)
        qS(a, l, p-1)
        qS(a, p+1, h)
a = [3,2,1,5,2]
qS(a, 0, len(a) - 1)

sec_max = -1
max = 0
i = len(a)-2
while i >= 0:
    if a[i] != max:
        sec_max = a[i]
